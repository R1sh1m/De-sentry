# ==============================================================================
#  De-Sentry .gitignore
#  Stack: C++17 / Python (stdlib HTTP client) / Static HTML dashboard
# ==============================================================================

# ── C++ Build Artifacts ────────────────────────────────────────────────────────
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt

# Compiled objects and binaries
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app

# Ninja
.ninja_deps
.ninja_log

# Precompiled headers
*.gch
*.pch

# ── Python ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyc

# Virtual environments
.venv/
venv/
env/
.env/
ENV/

# Eggs and distributions
*.egg
*.egg-info/
dist/
eggs/
.eggs/

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy / pyright type cache
.mypy_cache/
.pyright/
pyrightconfig.json

# ── De-Sentry Runtime Data (local node data — never commit) ───────────────────
data/
*.db
*.db-wal
*.db-shm

# Brain files (generated at runtime)
brain_*.json

# Node config with local IPs/ports (use config/node.example.json instead)
node_profile.toml

# Routing ledger and change ledger data files (runtime data -- not the
# src/ledger/ and include/desentry/ledger/ sources, which are tracked; the
# leading slash anchors these patterns to the repo root for exactly that
# reason, since a bare name would match source directories at any depth).
/ledger/
/transit/

# Benchmark temp file
.bench_tmp

# ── IDE and Editor Files ────────────────────────────────────────────────────────
# VS Code (commit workspace settings, ignore personal)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

# JetBrains (CLion, PyCharm)
.idea/
*.iml
*.iws
*.ipr
cmake-build-debug/
cmake-build-release/

# Visual Studio
*.user
*.suo
*.sln.docview
.vs/
x64/
x86/
Debug/
Release/

# Sublime Text
*.sublime-project
*.sublime-workspace

# ── OS Files ───────────────────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Secrets and Credentials (NEVER commit) ─────────────────────────────────────
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
.env
.env.*
!.env.example
secrets/
credentials/

# ── Temporary Files ────────────────────────────────────────────────────────────
*.tmp
*.temp
*.swp
*.swo
*~
\#*\#

# ------------------------------------------------------------------------------
#  v2 desktop app (app/)
# ------------------------------------------------------------------------------
app/node_modules/
app/dist/
app/src-tauri/target/
app/src-tauri/gen/
app/src-tauri/binaries/

# The sizing model and the ONNX Runtime are fetched once as a build step
# (`npm run fetch-model`) and bundled into the installer. ~40 MB of binaries
# nobody can review does not belong in a source tree.
app/resources/model/*
!app/resources/model/README.md
