        "relationship": 2.5,
        "relationships": 2.5,
        "network": 2.0,
        "hierarchy": 3.0,
        "tree": 2.0,
        "parent": 2.0,
        "children": 2.0,
        "follows": 2.5,
        "social": 2.5,
        "dependency": 3.0,
