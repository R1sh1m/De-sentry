            "required": ["series", "timestamp_ms", "value"]
          }
        }
      ]
    },
    {
      "workload": "vector",
      "label": "Vectors and similarity",
      "text": "Embeddings of text or images stored as numeric vectors and searched by similarity, so that asking for something returns the nearest matches by meaning rather than by exact value.",
      "keywords": {
        "vector": 4.0,
        "vectors": 4.0,
        "embedding": 4.0,
        "embeddings": 4.0,
        "similarity": 3.5,
        "semantic": 3.0,
        "nearest neighbour": 4.0,
        "nearest neighbor": 4.0,
        "knn": 3.0,
        "rag": 3.0,
        "retrieval": 2.5,
        "search": 1.5,
        "recommend": 2.5,
        "recommendation": 2.5,
        "image search": 3.0,
        "cosine": 3.0
      },
      "engines": ["vector_hnsw_lite", "kv"],
      "default_engine": "kv",
      "quota_split": { "db_pct": 45, "transit_store_pct": 15, "cache_hash_pct": 25, "ledger_pct": 10, "net_buffers_pct": 5 },
      "shard_key": "",
      "replication_factor": 3,
      "secondary_indexes": [],
      "retention_days": 0,
      "collections": [
        {
          "name": "embeddings",
          "engine": "vector_hnsw_lite",
