      "quota_split": { "db_pct": 60, "transit_store_pct": 15, "cache_hash_pct": 10, "ledger_pct": 10, "net_buffers_pct": 5 },
      "shard_key": "",
      "replication_factor": 3,
      "secondary_indexes": [],
