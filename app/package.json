{
  "name": "de-sentry-app",
  "version": "2.0.0",
  "private": true,
  "description": "De-Sentry control room \u2014 the single point of access to a peer-to-peer database mesh.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/stage-sidecar.mjs && tauri build",
    "fetch-model": "node scripts/fetch-model.mjs",
    "check:qr": "node tests/qr.check.mjs",
    "icons": "python scripts/make-icons.py",
    "stage-sidecar": "node scripts/stage-sidecar.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
