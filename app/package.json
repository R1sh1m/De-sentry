{
  "name": "de-sentry-app",
  "version": "1.2.0",
  "private": true,
  "description": "De-Sentry control room — the single point of access to a peer-to-peer database mesh.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "node scripts/tauri-wrapper.mjs",
    "build:engine": "cmake --build ../build --config RelWithDebInfo",
    "tauri:dev": "npm run build:engine && node scripts/stage-sidecar.mjs && tauri dev",
    "tauri:build": "npm run build:engine && node scripts/stage-sidecar.mjs && tauri build",
    "fetch-model": "node scripts/fetch-model.mjs",
    "check:qr": "node tests/qr.check.mjs",
    "check:css": "node tests/css.check.mjs",
    "check:a11y": "node tests/a11y.check.mjs",
    "test": "vitest run",
    "icons": "python scripts/make-icons.py",
    "stage-sidecar": "node scripts/stage-sidecar.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.12.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
