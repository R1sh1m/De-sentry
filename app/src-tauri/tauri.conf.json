{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "De-Sentry",
  "version": "1.0.1",
  "identifier": "dev.desentry",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "De-Sentry",
        "width": 1360,
        "height": 880,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 19, "y": 28 },
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Peer-to-peer database control room",
    "longDescription": "De-Sentry manages a mesh of peer-to-peer database nodes across the machines and drives you own. It works with no internet connection at all.",
    "copyright": "© 2026 De-Sentry Project",
    "externalBin": ["binaries/desentryd", "binaries/desentryd-universal-apple-darwin"],
    "resources": {
      "../resources/prototypes.json": "resources/prototypes.json",
      "../resources/facets.json": "resources/facets.json",
      "../resources/knowledge/": "resources/knowledge/",
      "../resources/model/": "resources/model/"
    },
    "windows": {
      "wix": null,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": null,
      "exceptionDomain": ""
    },
    "linux": {
      "deb": {
        "depends": ["libssl3", "libssl3t64"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "shell": {
      "open": false
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/R1sh1m/De-sentry/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzOEI0M0U0MTI1RTU3MgpSV1J5NVNWQlByUTREUFpKT2Yvb1dxbnAwcktnWGI0N01aNmdyeGZGdmVyQkhiMG9VNlNIZ0MrSQo="
    }
  }
}
